{
  "name": "yuben-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "YuBen marketing website. Independent from the local app build and npm package.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 5288 --strictPort",
    "build": "node scripts/fetch-stars.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 5289 --strictPort",
    "lint": "oxlint src scripts tests",
    "typecheck": "tsc -b",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "stars": "node scripts/fetch-stars.mjs",
    "build:offline": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.92.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.6"
  }
}
