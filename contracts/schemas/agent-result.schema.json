{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuben.dev/schemas/agent-result.schema.json",
  "title": "AgentResult",
  "description": "CLI -> backend. A strict SUBSET of ResearchResult carrying narrative + video_id references ONLY. The agent invents no numbers and no IDs: every video_id must exist in the collected script JSON or the backend drops the reference (CONTRACTS.md §7, PRD §8 trust split).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "topic_title", "summary", "keywords", "top_video_ids", "watch_list", "title_analysis", "script_analysis"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "topic_title": { "type": "string" },
    "summary": { "type": "string" },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Expanded search terms the agent used."
    },
    "top_video_ids": {
      "type": "array",
      "description": "Section A curation: ordered video_id references into the collected set. Numbers are attached by the backend, never by the agent.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["video_id", "rank"],
        "properties": {
          "video_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
          "rank": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "watch_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["video_id", "learning_goal", "why", "rank"],
        "properties": {
          "video_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
          "learning_goal": { "type": "string" },
          "why": { "type": "string" },
          "rank": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "title_analysis": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["common_features", "emotional_triggers"],
          "properties": {
            "common_features": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["n", "pattern", "note", "count"],
                "properties": {
                  "n": { "type": "integer", "minimum": 1 },
                  "pattern": { "type": "string" },
                  "note": { "type": "string" },
                  "count": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "emotional_triggers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["n", "trigger", "example"],
                "properties": {
                  "n": { "type": "integer", "minimum": 1 },
                  "trigger": { "type": "string" },
                  "example": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    },
    "script_analysis": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration_sweet_spot", "structure_patterns", "hook_breakdown", "what_to_avoid"],
          "properties": {
            "duration_sweet_spot": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "value"],
                "properties": {
                  "label": { "type": "string" },
                  "value": { "type": "string" }
                }
              }
            },
            "structure_patterns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "note"],
                "properties": {
                  "name": { "type": "string" },
                  "note": { "type": "string" }
                }
              }
            },
            "hook_breakdown": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rank", "title", "hook", "video_id"],
                "properties": {
                  "rank": { "type": "integer", "minimum": 1 },
                  "title": { "type": "string" },
                  "hook": { "type": "string" },
                  "video_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" }
                }
              }
            },
            "what_to_avoid": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "title_formulas": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shape", "proof_video_id", "tailored"],
        "properties": {
          "shape": { "type": "string" },
          "proof_video_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
          "tailored": { "type": "string" }
        }
      }
    },
    "game_plan": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outline", "title_options", "thumbnail_concepts", "do", "dont"],
          "properties": {
            "outline": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["t", "beat"],
                "properties": {
                  "t": { "type": "string" },
                  "beat": { "type": "string" }
                }
              }
            },
            "title_options": { "type": "array", "items": { "type": "string" } },
            "thumbnail_concepts": { "type": "array", "items": { "type": "string" } },
            "do": { "type": "string" },
            "dont": { "type": "string" }
          }
        }
      ]
    }
  }
}
